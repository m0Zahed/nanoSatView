VITE_ENV=development
TESTING_REMOTE_LAN=false
# When true, localhost defaults switch to http://<current-browser-host>:{5000,5001,8080}
# You can still override each service explicitly with VITE_*_BASE_URL variables.
VITE_REQUIREMENTS_BASE_URL=http://localhost:5001
# VITE_AUTH_BASE_URL=http://localhost:5000
# VITE_DOCUMENT_PROCESSOR_BASE_URL=http://localhost:8080
# Set either of these for UI-only testing without requirements backend:
# VITE_ENV=testing
# VITE_BYPASS_REQUIREMENTS_API=true
