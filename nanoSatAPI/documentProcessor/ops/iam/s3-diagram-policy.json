{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowBucketDiscovery",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::REPLACE_WITH_BUCKET_NAME",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "diagrams/*"
          ]
        }
      }
    },
    {
      "Sid": "AllowDiagramObjectReadWrite",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:AbortMultipartUpload"
      ],
      "Resource": "arn:aws:s3:::REPLACE_WITH_BUCKET_NAME/diagrams/*"
    }
  ]
}
